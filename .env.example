# OfferFlow AI — example environment for local development.
# Copy to .env (gitignored, never committed) and replace every REPLACE_ME value.
# Passwords must be URL-safe (letters and digits) because the broker URL is
# assembled from them; see backend/README.md for generation commands.

# Django secret. Long random string, unique per environment.
OFFERFLOW_SECRET_KEY=REPLACE_ME_generate_a_long_random_string
# Local development only. Never enable outside local Compose.
OFFERFLOW_DEBUG=true
OFFERFLOW_ALLOWED_HOSTS=localhost,127.0.0.1,backend

OFFERFLOW_DB_NAME=offerflow
OFFERFLOW_DB_USER=offerflow
OFFERFLOW_DB_PASSWORD=REPLACE_ME_url_safe_password

OFFERFLOW_RABBITMQ_USER=offerflow
OFFERFLOW_RABBITMQ_PASSWORD=REPLACE_ME_url_safe_password

# Provider selection. "fixture" (default) performs zero network I/O.
# "meta" additionally requires every paid control below plus a token budget.
OFFERFLOW_PROVIDER=fixture

# Exchange-rate source. "fixture" (default) returns deterministic synthetic
# demo rates, always labeled simulated; anything else refuses until a real
# rates provider is configured.
OFFERFLOW_FX_PROVIDER=fixture

# Paid model path. All of the switch, key, and model must be set
# deliberately; anything missing refuses dispatch. Never commit real values.
OFFERFLOW_ALLOW_PAID=false
OFFERFLOW_META_API_KEY=
# Exact model id from your account (case-sensitive, copy it verbatim).
# OfferFlow needs a muse-spark CHAT model for row interpretation; the
# account below also exposes image, voice, and specialist ids, which
# cannot serve chat completions and must not be used here.
# Observed 2026-10-30 on one Contributor account (verify yours; ids change):
#   muse-spark-1.3-contributor  <- newest contributor chat model (use this)
#   muse-spark-1.3              chat model, standard billing
#   muse-spark-1.2-contributor  previous contributor chat model
#   muse-spark-1.2              previous chat model, standard billing
#   muse-spark-1.1              older chat model
#   muse-image-1.0, muse-voice-transcribe-1.0, muse-wonder-1.0, sam-3.1
#                               NOT chat models; unusable for this field
# Re-list your own access any time (free call, spends zero tokens):
#   docker compose exec backend python -c "
#   import os
#   from openai import OpenAI
#   c = OpenAI(api_key=os.environ['OFFERFLOW_META_API_KEY'],
#              base_url=os.environ.get('OFFERFLOW_META_BASE_URL'))
#   print(sorted(m.id for m in c.models.list()))"
# Blank means the built-in default (muse-spark-1.3-contributor).
OFFERFLOW_META_MODEL=
# Optional tuning (defaults shown).
OFFERFLOW_META_BASE_URL=https://api.meta.ai/v1
OFFERFLOW_META_TIMEOUT_SECONDS=60
OFFERFLOW_META_MAX_INPUT_TOKENS=8000
OFFERFLOW_META_MAX_OUTPUT_TOKENS=2000
OFFERFLOW_META_MAX_IN_FLIGHT=1

# Password recovery mail. Links point at the frontend below; configure a
# real SMTP relay in production (default localhost delivers nowhere).
OFFERFLOW_FRONTEND_URL=http://127.0.0.1:4344
OFFERFLOW_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
OFFERFLOW_EMAIL_HOST=localhost
OFFERFLOW_EMAIL_PORT=587
OFFERFLOW_EMAIL_USER=
OFFERFLOW_EMAIL_PASSWORD=
OFFERFLOW_EMAIL_TLS=true
OFFERFLOW_EMAIL_FROM=OfferFlow AI <no-reply@example.com>

OFFERFLOW_APP_VERSION=0.4.0-beta
