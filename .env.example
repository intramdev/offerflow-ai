# OfferFlow AI — example environment for local development.
# Copy to .env (gitignored, never committed) and replace every REPLACE_ME value.
# Passwords must be URL-safe (letters and digits) because the broker URL is
# assembled from them; see backend/README.md for generation commands.

# Django secret. Long random string, unique per environment.
OFFERFLOW_SECRET_KEY=REPLACE_ME_generate_a_long_random_string
# Local development only. Never enable outside local Compose.
OFFERFLOW_DEBUG=true
OFFERFLOW_ALLOWED_HOSTS=localhost,127.0.0.1,backend

OFFERFLOW_DB_NAME=offerflow
OFFERFLOW_DB_USER=offerflow
OFFERFLOW_DB_PASSWORD=REPLACE_ME_url_safe_password

OFFERFLOW_RABBITMQ_USER=offerflow
OFFERFLOW_RABBITMQ_PASSWORD=REPLACE_ME_url_safe_password

# Provider selection. "fixture" (default) performs zero network I/O.
# "meta" additionally requires every paid control below plus a token budget.
OFFERFLOW_PROVIDER=fixture

# Paid model path. All of the switch, key, and model must be set
# deliberately; anything missing refuses dispatch. Never commit real values.
OFFERFLOW_ALLOW_PAID=false
OFFERFLOW_META_API_KEY=
OFFERFLOW_META_MODEL=
# Optional tuning (defaults shown).
OFFERFLOW_META_BASE_URL=https://api.meta.ai/v1
OFFERFLOW_META_TIMEOUT_SECONDS=60
OFFERFLOW_META_MAX_INPUT_TOKENS=8000
OFFERFLOW_META_MAX_OUTPUT_TOKENS=2000
OFFERFLOW_META_MAX_IN_FLIGHT=1

OFFERFLOW_APP_VERSION=dev
